# OpenAI is the only supported LLM provider.
# Every variable also works without the HOTEL_ASSISTANCE_ prefix.
HOTEL_ASSISTANCE_OPENAI_API_KEY=replace-me

# Extraction model, plus a cheaper model used for short follow-up messages.
HOTEL_ASSISTANCE_OPENAI_MODEL=gpt-5-mini
HOTEL_ASSISTANCE_OPENAI_FALLBACK_MODEL=gpt-4.1-mini
HOTEL_ASSISTANCE_OPENAI_FALLBACK_MAX_WORDS=12

# Candidate preselection: "hybrid" (embeddings + reserved alias matches),
# "semantic" (embeddings only), or "keyword" (no API calls at all).
HOTEL_ASSISTANCE_RETRIEVAL_MODE=hybrid
HOTEL_ASSISTANCE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HOTEL_ASSISTANCE_FILTER_TOP_K=24
HOTEL_ASSISTANCE_EMBEDDING_CACHE_PATH=.cache/filter_embeddings.json

# Hotel backend. Leave empty to report the offer count as unknown
# instead of inventing one.
HOTEL_ASSISTANCE_HOTEL_BACKEND_URL=
HOTEL_ASSISTANCE_HOTEL_BACKEND_TIMEOUT=10.0

HOTEL_ASSISTANCE_LOG_LEVEL=INFO
